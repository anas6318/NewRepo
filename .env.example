# ─────────────────────────────────────────────────────────────────────────────
# CROWNED — environment variables
# Frontend variables MUST be prefixed VITE_ (they are embedded in the client
# bundle — never put secrets in VITE_ variables).
# Server-side secrets live ONLY in Supabase Edge Function secrets
# (`supabase secrets set`), never in the frontend env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (public — safe to embed) ───────────────────────────────────────
# Leave VITE_SUPABASE_URL empty to run the app in clearly-labeled DEMO MODE
# (local in-browser data, no external services, simulated checkout).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=https://example.com
VITE_DEMO_MODE=
VITE_WHATSAPP_NUMBER=            # e.g. 9725XXXXXXXX (placeholder — owner input)
VITE_INSTAGRAM_USERNAME=         # e.g. crowned (placeholder — owner input)
VITE_GA4_ID=                     # G-XXXXXXX (analytics disabled when empty)
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_INTERNATIONAL_MODE=disabled # disabled | waitlist | enabled

# ── Supabase Edge Function secrets (set via `supabase secrets set NAME=...`) ─
# Never commit real values. Never expose these to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=     # provided automatically inside edge functions
# PAYMENT_PROVIDER=              # e.g. israeli-gateway | paypal
# ISRAELI_GATEWAY_API_KEY=
# ISRAELI_GATEWAY_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# BIT_BUSINESS_API_KEY=          # only with a real business integration
# PAYBOX_BUSINESS_API_KEY=       # only with a real business integration
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEET_ID=               # a NEW sheet — never the old order spreadsheet
# EMAIL_PROVIDER=console         # console | resend
# RESEND_API_KEY=
# EMAIL_FROM=orders@example.com
# ORDER_NOTIFICATION_EMAIL=      # owner inbox alerted on every NEW ORDER.
#                                # Empty → no owner alert is attempted and the
#                                # order records notification.status=disabled.
#                                # Requires EMAIL_PROVIDER=resend + RESEND_API_KEY
#                                # to actually send; console mode only logs.
# ADMIN_BASE_URL=                # optional, e.g. https://yourdomain.tld — used
#                                # only to put a direct Admin order link in the
#                                # owner alert. Falls back to ALLOWED_ORIGIN.
# TRACKING_HASH_SECRET=          # random 32+ chars, for order-tracking hashes

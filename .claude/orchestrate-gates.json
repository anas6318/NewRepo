{
  "$comment": "Gates for the orchestrate plugin. Worktrees share the root node_modules via a junction (no dependency changes in this run).",
  "install": "[ -e node_modules ] || cmd //c \"mklink /J node_modules C:\\\\Users\\\\PC\\\\Documents\\\\GitHub\\\\NewRepo\\\\node_modules\" >/dev/null",
  "sharedCache": {
    "note": "node_modules is a junction to the integration root's node_modules; never run npm install in a worktree."
  },
  "cachePaths": [
    "dist/**",
    "*.tsbuildinfo"
  ],
  "gates": {
    "unit": [
      {
        "id": "typecheck",
        "cmd": "npm run -s typecheck"
      },
      {
        "id": "lint",
        "cmd": "npx eslint ."
      },
      {
        "id": "test",
        "cmd": "npm test --silent"
      }
    ],
    "ship": [
      {
        "id": "typecheck",
        "cmd": "npm run -s typecheck"
      },
      {
        "id": "lint",
        "cmd": "npx eslint ."
      },
      {
        "id": "test",
        "cmd": "npm test --silent"
      },
      {
        "id": "e2e-navigation",
        "cmd": "node tests/e2e/run-e2e.mjs navigation"
      },
      {
        "id": "e2e-catalog",
        "cmd": "node tests/e2e/run-e2e.mjs --skip-build catalog"
      },
      {
        "id": "e2e-admin",
        "cmd": "node tests/e2e/run-e2e.mjs --skip-build admin"
      }
    ]
  }
}
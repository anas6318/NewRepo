{
  "name": "crowned-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CROWNED — premium multilingual (ar/he/en) football jersey ecommerce platform. React + Vite + TypeScript + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/typecheck.mjs && vite build && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "demo:images": "node scripts/generate-demo-images.mjs",
    "sandbox:build": "node scripts/sandbox-build.mjs",
    "sandbox:serve": "node scripts/serve.mjs dist 4173",
    "screenshots": "node scripts/screenshot-audit.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.49.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
